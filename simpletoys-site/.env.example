# Copiez ce fichier en ".env" (sans ".example") et remplissez vos vraies valeurs.
# Le fichier ".env" ne doit JAMAIS être publié sur GitHub ou partagé publiquement.

# URL publique de votre site une fois déployé (utilisé pour CORS)
SITE_URL=https://votresite.com

# ---- Sécurité ----
# Générez une chaîne aléatoire longue, ex: openssl rand -hex 32
JWT_SECRET=changez_moi_par_une_chaine_aleatoire_longue

# Générez ce hash avec: npm run hash-password -- VotreNouveauMotDePasse
# NE JAMAIS mettre le mot de passe en clair ici.
ADMIN_PASSWORD_HASH=

# ---- Email (Gmail) ----
EMAIL_USER=simpeltoysmaroc@gmail.com
# Mot de passe D'APPLICATION Gmail (16 caractères), PAS le mot de passe du compte.
# À générer sur https://myaccount.google.com/apppasswords (nécessite la validation en 2 étapes activée)
EMAIL_APP_PASSWORD=

PORT=3000
